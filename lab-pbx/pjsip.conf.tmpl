; Lab PBX for LabPhone. Ports 5160 (UDP/TCP) and 5161 (TLS) so it can run next to a
; softphone on the same computer, which uses 5060/5061.
[global]
type=global
user_agent=LabPBX (Asterisk)

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5160
external_media_address=@EXTERNAL_IP@
external_signaling_address=@EXTERNAL_IP@

[transport-tcp]
type=transport
protocol=tcp
bind=0.0.0.0:5160
external_media_address=@EXTERNAL_IP@
external_signaling_address=@EXTERNAL_IP@

[transport-tls]
type=transport
protocol=tls
bind=0.0.0.0:5161
cert_file=/etc/asterisk/keys/asterisk.crt
priv_key_file=/etc/asterisk/keys/asterisk.key
method=tlsv1_2
external_media_address=@EXTERNAL_IP@
external_signaling_address=@EXTERNAL_IP@

[phone](!)
type=endpoint
context=lab
disallow=all
allow=ulaw,alaw
dtmf_mode=rfc4733
rewrite_contact=yes
rtp_symmetric=yes
force_rport=yes
direct_media=no

; 1001, 1002: SIP over TLS + mandatory SRTP
[1001](phone)
transport=transport-tls
media_encryption=sdes
auth=1001
aors=1001
[1001]
type=auth
auth_type=userpass
username=1001
password=secret1001
[1001]
type=aor
max_contacts=1
remove_existing=yes

[1002](phone)
transport=transport-tls
media_encryption=sdes
auth=1002
aors=1002
[1002]
type=auth
auth_type=userpass
username=1002
password=secret1002
[1002]
type=aor
max_contacts=1
remove_existing=yes

; 1003: plain SIP/UDP + RTP, for comparison in Wireshark
[1003](phone)
transport=transport-udp
auth=1003
aors=1003
[1003]
type=auth
auth_type=userpass
username=1003
password=secret1003
[1003]
type=aor
max_contacts=1
remove_existing=yes
